{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeManagerRoles",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:SetSourceIdentity"
      ],
      "Resource": [
        "arn:aws:iam::<account-id>:role/DevOpsAgentManagerRead",
        "arn:aws:iam::<account-id>:role/DevOpsAgentManagerWrite"
      ]
    }
  ]
}
