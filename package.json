{
  "name": "devops-agent-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname ${DAM_HOST:-127.0.0.1} --port ${PORT:-3000}",
    "dev:worker": "DAM_PROCESS=worker tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.json src/worker/index.ts",
    "build": "next build && pnpm build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start --hostname ${DAM_HOST:-127.0.0.1} --port ${PORT:-3000}",
    "start:worker": "DAM_PROCESS=worker node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/worker.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/db/migrate.ts",
    "db:push": "drizzle-kit push --force",
    "db:dev:up": "podman compose -f compose.dev.yaml up -d",
    "db:dev:down": "podman compose -f compose.dev.yaml down",
    "stack": "scripts/stack.sh",
    "demo:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig tsconfig.json scripts/demo-seed/all.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.138",
    "@aws-sdk/client-bedrock": "3.1166.0",
    "@aws-sdk/client-cloudtrail": "3.1166.0",
    "@aws-sdk/client-devops-agent": "3.1166.0",
    "@aws-sdk/client-sts": "3.1166.0",
    "@aws-sdk/credential-providers": "3.1166.0",
    "ai": "7.0.169",
    "ajv": "8.20.0",
    "better-auth": "1.7.21",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "diff": "8.0.4",
    "drizzle-orm": "0.45.4",
    "jszip": "3.10.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "shadcn": "^4.23.0",
    "simple-git": "4.0.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@smithy/types": "4.20.0",
    "@tailwindcss/turbopack": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "aws-sdk-client-mock": "4.1.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12.0"
  }
}
