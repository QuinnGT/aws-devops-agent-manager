# Copy to .env (git-ignored) and fill in. Secrets: prefer the *_FILE variants.
#
# To run the app in containers you do not need to write this file: ./scripts/stack.sh up and
# ./scripts/stack.sh demo create .env with random passwords on first use. Edit it to change
# the ports or any other setting below.

# Password of the database in the full stack (compose.yaml, ./scripts/stack.sh up).
# Generate: openssl rand -hex 24
DAM_POSTGRES_PASSWORD=
# Password of the demo stack's own database (compose.demo.yaml, ./scripts/stack.sh demo)
DAM_DEMO_POSTGRES_PASSWORD=
# Dev database password for compose.dev.yaml, used when you run the app natively (pnpm db:dev:up)
DAM_DEV_POSTGRES_PASSWORD=

# Host ports of the container stacks. Both are published on 127.0.0.1 only.
# DAM_PORT=3000
# DAM_DEMO_PORT=3001

# Container stacks: an image published for this project (ghcr.io/<owner>/devops-agent-manager:<tag>).
# It is pulled instead of building one from this folder.
# DAM_IMAGE=
# Container stacks: the folder mounted read-only as ~/.aws in the app containers when you use
# ./scripts/stack.sh up --mount-aws-dir, or have no AWS CLI (default ~/.aws). Normally the AWS CLI on your
# computer passes renewing credentials to the containers and no ~/.aws is mounted.
# DAM_AWS_DIR=
# Container stacks: a command that signs you in to AWS, for an Okta tool that writes keys into ~/.aws/credentials.
# ./scripts/stack.sh up and login run it ($AWS_PROFILE holds the profile). IAM Identity Center profiles need
# no command: they use "aws sso login".
# DAM_AWS_LOGIN_COMMAND='okta-aws-cli web --profile my-profile'
# Container stacks: skip the check that the container engine has 3.5 GiB of memory to build the image.
# DAM_SKIP_MEMORY_CHECK=1
# Container stacks: a folder of policy files mounted read-only and merged over policy/. Written by
# ./scripts/stack.sh up --policy <folder>, removed by --policy none. Use an absolute path in single quotes.
# DAM_POLICY_OVERLAY_HOST_DIR='/path/to/my-policy'

# DATABASE_URL or DATABASE_URL_FILE (scripts/dev-db-url.sh prints the dev URL)
# DATABASE_URL_FILE=/run/secrets/database_url

# Native run only: bind address and port. Keep 127.0.0.1 outside a container.
DAM_HOST=127.0.0.1
PORT=3000

# Local mode sign-in bypass (allowed only on 127.0.0.1, or in a container published to 127.0.0.1 only).
# The container stacks turn it on themselves; leave these commented out for them. For a native run,
# set AUTH_DEV_BYPASS=true here or on the command line, or the app rejects every request.
# AUTH_DEV_BYPASS=true
# AUTH_DEV_USER_EMAIL=local@localhost
# AUTH_DEV_ROLE=admin

# Hosted mode sign-in (OIDC)
# OIDC_ISSUER=https://cognito-idp.us-west-2.amazonaws.com/<pool-id>
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# BETTER_AUTH_SECRET_FILE=/run/secrets/better_auth_secret
# BETTER_AUTH_URL=https://devops.example.com
# DAM_ALLOWED_ORIGINS=https://devops.example.com

# Where git working copies and export files live
DAM_DATA_DIR=./data

# Extra policy directories merged over policy/, lowest precedence first, separated by ":" (";" on Windows). Missing ones are skipped with a warning.
# DAM_POLICY_OVERLAY_DIRS=/path/to/my-policy
